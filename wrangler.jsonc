{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nori-tico-wedding",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "nori-tico-wedding"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nori-tico-wedding-db",
      "database_id": "fd720136-806e-47c6-9c8c-cbfd03925639",
      "migrations_dir": "drizzle"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "nori-tico-media"
    }
  ],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "noridayagustin.com", "custom_domain": true },
    { "pattern": "www.noridayagustin.com", "custom_domain": true }
  ],
  "vars": {
    "SITE_URL": "https://noridayagustin.com",
    "AI_MODEL": "@cf/mistralai/mistral-small-3.1-24b-instruct"
  },
  "observability": {
    "enabled": true
  }
}
