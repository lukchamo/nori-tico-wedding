{
  "name": "nori-tico-wedding",
  "version": "1.0.0",
  "private": true,
  "description": "Invitación de boda Norida & Agustín — Next.js en Cloudflare Workers (OpenNext) con D1 + Drizzle, Workers AI y backoffice de invitados.",
  "scripts": {
    "dev": "next dev",
    "build": "NODE_ENV=production next build",
    "lint": "tsc --noEmit",
    "preview": "NODE_ENV=production opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "NODE_ENV=production opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:build": "node scripts/build-seed.mjs",
    "og": "node scripts/render-og.mjs"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "drizzle-orm": "^0.45.4",
    "gsap": "^3.15.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.14",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3",
    "wrangler": "^4.156.0"
  }
}
